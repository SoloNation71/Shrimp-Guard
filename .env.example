# ─────────────────────────────────────────────
# ShrimpGuard — Environment Variable Template
# Copy this to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# ── Supabase (Auth) ──────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Server-side JWT secret — Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret

# ── InfluxDB Cloud 2 (Time-series DB) ────────
# Get these from: https://cloud2.influxdata.com → Load Data → API Tokens
INFLUXDB_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUXDB_TOKEN=your-influxdb-api-token
INFLUXDB_ORG=your-org-name
INFLUXDB_BUCKET=shrimpguard

# ── Go2RTC (RTSP → WebRTC/HLS proxy) ─────────
# Default local: http://localhost:1984
# For Replit deployment, run Go2RTC as a sidecar or external service
GO2RTC_BASE_URL=http://localhost:1984
GO2RTC_API_KEY=

# ── Express Backend ───────────────────────────
# Port the API server listens on (Vite proxies /api → this port)
API_PORT=3001
NODE_ENV=development

# ── Frontend (Vite) ───────────────────────────
# These VITE_ vars are exposed to the browser
# Leave VITE_SUPABASE_* blank to use mock auth for local development
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
